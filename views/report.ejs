<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0" />
		<title>Document</title>
		<style>
			body {
				font-family: "fira code";
				width: 100%;
				height: 100vh;

				& .report-section {
					display: flex;
					flex-direction: column;

					& ul {
						display: flex;
						justify-content: center;
						align-items: center;
						text-align: center;
						gap: 2rem;
						list-style: none;

						& li {
							border: 1px dashed;
							border-radius: 10px;
							padding: 5px;
						}
					}

					h1 {
						margin: 0 auto;
					}
				}
			}
		</style>
	</head>
	<body>
		<%- include('header')%>
		<section class="report-section">
			<h1>Student Report Card</h1>
			<ul>
				<% students.map((stud) => { %>
				<li>
					<p>Name: <%= stud.name %></p>
					<p>Grade: <%= stud.grade %></p>
					<p>FSubject: <%= stud.favouriteSubject %></p>
				</li>
				<% }) %>
			</ul>
		</section>
	</body>
</html>
